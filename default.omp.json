{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "console_title_template": "{{ .Folder }}",
  "patch_pwsh_bleed": true,
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "python",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#d6deeb",
          "background": "#575656"
        },
        {
          "background": "#FEF5ED",
          "foreground": "#011627",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": " \uf489 {{ .Name }} ",
          "trailing_diamond": "\ue0b0",
          "type": "shell"
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#ffffff",
          "background": "background"
        },
        {
          "type": "spotify",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " {{ .Icon }} {{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }} ",
          "options": {
            "playing_icon": "\uf001",
            "paused_icon": "\uf04c"
          },
          "foreground": "#ffffff",
          "background": "background"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#17D7A0",
          "foreground": "#011627",
          "leading_diamond": "\ue0b2",
          "options": {
            "branch_icon": "\ue725 "
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b0",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf07c {{ .Path }} ",
          "options": {
            "style": "folder",
            "max_depth": 1
          },
          "foreground": "#ffffff",
          "background": "background"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "powerline_symbol": "\ue0b0",
          "template": " \uf007 {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#ffffff",
          "background": "background"
        }
      ],
      "type": "prompt"
    }
  ]
}